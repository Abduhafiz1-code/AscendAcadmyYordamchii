{
  "name": "ascend-academy-bot",
  "version": "3.0.0",
  "private": true,
  "description": "Ascend Academy Telegram bot on Supabase Edge Functions",
  "scripts": {
    "check": "deno check supabase/functions/telegram/index.ts supabase/functions/worker/index.ts",
    "test": "deno test --allow-env --allow-read --allow-net supabase/tests",
