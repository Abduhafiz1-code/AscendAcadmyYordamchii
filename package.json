  },
  "devDependencies": {
    "deno": "^2.9.6"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@supabase/supabase-js": "^2.119.0",
    "satori": "^0.63.2"
  }
}
